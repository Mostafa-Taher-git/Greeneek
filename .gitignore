```
# Configuration and build artifacts
*.cordis.yml
*.yml.bak
*.yaml.bak

# Dependencies and build directories
node_modules/
dist/
build/
target/
*.tgz

# Compiled package outputs (tsc/tsdown emit; sources live under src/)
packages/*/*/lib/
apps/*/lib/
vendor/*/lib/
*.tsbuildinfo

# Local build/test residue (regenerable; never commit)
.artifacts/
.gnk-build/
apps/desktop/.staging/

# Generator-test scratch workspaces (created under packages/typert/generator/tests, cleaned after each test)
packages/typert/generator/tests/.typert-*/
packages/typert/generator/tests/.generated-*/
packages/typert/generator/tests/.rendered-*/

# Python specific
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/

# Logs and temporary files
*.log
*.tmp
*.temp
*.cache

# Environment files
.env
.env.local
*.env.*

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db

# Coverage and testing
.coverage
coverage/
htmlcov/
.pytest_cache/
.mypy_cache/
```