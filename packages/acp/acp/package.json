{
  "name": "@greeneek/gnk-acp",
  "description": "Automation-only Agent Client Protocol server for driving Greeneek Harness agents over JSON-RPC stdio",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/acp/acp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@agentclientprotocol/sdk": "1.4.0",
    "@greeneek/gnk-brand": "workspace:^",
    "@greeneek/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-attachment": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-mcp-client": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-session-persistence": "workspace:^",
    "@greeneek/gnk-token-meter": "workspace:^",
    "@greeneek/gnk-user-approval": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@greeneek/gnk-token-meter": {
      "optional": true
    }
  },
  "devDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-agent-loop": "workspace:^",
    "@greeneek/gnk-agent-loop-testkit": "workspace:^",
    "@greeneek/gnk-attachment": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-mcp-client": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-session-persistence": "workspace:^",
    "@greeneek/gnk-session-persistence-jsonl": "workspace:^",
    "@greeneek/gnk-session-projection": "workspace:^",
    "@greeneek/gnk-token-meter": "workspace:^",
    "@greeneek/gnk-tools": "workspace:^",
    "@greeneek/gnk-user-approval": "workspace:^"
  }
}
