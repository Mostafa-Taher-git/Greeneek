{
  "name": "@greeneek/gnk-api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "gnk": {
    "client": {
      "inject": [
        "@greeneek/gnk-api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@greeneek/gnk-deque": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-util-values": "workspace:^"
  },
  "peerDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-scope": "workspace:^"
  },
  "devDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-agent-presets": "workspace:^",
    "@greeneek/gnk-api-gateway": "workspace:^",
    "@greeneek/gnk-api-settings-controller": "workspace:^",
    "@greeneek/gnk-api-workspace-controller": "workspace:^",
    "@greeneek/gnk-commands": "workspace:^",
    "@greeneek/gnk-cordis-host-runner": "workspace:^",
    "@greeneek/gnk-credentials": "workspace:^",
    "@greeneek/gnk-file-reference": "workspace:^",
    "@greeneek/gnk-goal": "workspace:^",
    "@greeneek/gnk-host-plugin-inventory": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-message-feedback": "workspace:^",
    "@greeneek/gnk-session-reference": "workspace:^",
    "@greeneek/gnk-settings": "workspace:^",
    "@greeneek/gnk-subagent": "workspace:^",
    "@greeneek/gnk-user-approval": "workspace:^",
    "@greeneek/gnk-user-questions": "workspace:^",
    "@greeneek/gnk-client-connection": "workspace:^",
    "@greeneek/gnk-typert-protocol": "workspace:^",
    "@greeneek/gnk-scope": "workspace:^",
    "@greeneek/gnk-api-session-controller": "workspace:^"
  }
}
