{
  "name": "@greeneek/gnk-api-session-controller",
  "description": "Session Remote commands, cold reads, and live control transport",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/api/session-controller"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./remote-events": {
      "types": "./lib/types/remote-events.d.ts",
      "default": "./lib/types/remote-events.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "gnk": {
    "client": {
      "external": [
        "@greeneek/gnk-api-gateway/client"
      ],
      "inject": [
        "@greeneek/gnk-api-gateway"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@greeneek/gnk-brand": "workspace:^",
    "@greeneek/gnk-deque": "workspace:^",
    "@greeneek/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-agent-default-model": "workspace:^",
    "@greeneek/gnk-agent-presets": "workspace:^",
    "@greeneek/gnk-api-gateway": "workspace:^",
    "@greeneek/gnk-attachment": "workspace:^",
    "@greeneek/gnk-client-connection": "workspace:^",
    "@greeneek/gnk-file-reference": "workspace:^",
    "@greeneek/gnk-jobs": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-native-command": "workspace:^",
    "@greeneek/gnk-scope": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-session-persistence": "workspace:^",
    "@greeneek/gnk-session-projection": "workspace:^",
    "@greeneek/gnk-session-projection-cache": "workspace:^",
    "@greeneek/gnk-session-query": "workspace:^",
    "@greeneek/gnk-session-title": "workspace:^",
    "@greeneek/gnk-skill": "workspace:^",
    "@greeneek/gnk-subagent": "workspace:^",
    "@greeneek/gnk-typert-protocol": "workspace:^",
    "@greeneek/gnk-typert-registry": "workspace:^",
    "@greeneek/gnk-util-time": "workspace:^",
    "@greeneek/gnk-util-workspace-path": "workspace:^",
    "@greeneek/gnk-workspace": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@greeneek/gnk-jobs": {
      "optional": true
    },
    "@greeneek/gnk-session-persistence": {
      "optional": true
    },
    "@greeneek/gnk-session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-agent-default-model": "workspace:^",
    "@greeneek/gnk-agent-presets": "workspace:^",
    "@greeneek/gnk-api-gateway": "workspace:^",
    "@greeneek/gnk-attachment": "workspace:^",
    "@greeneek/gnk-client-connection": "workspace:^",
    "@greeneek/gnk-client-store": "workspace:^",
    "@greeneek/gnk-file-reference": "workspace:^",
    "@greeneek/gnk-jobs": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-native-command": "workspace:^",
    "@greeneek/gnk-permission-presets": "workspace:^",
    "@greeneek/gnk-scope": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-session-persistence": "workspace:^",
    "@greeneek/gnk-session-projection": "workspace:^",
    "@greeneek/gnk-session-projection-cache": "workspace:^",
    "@greeneek/gnk-session-query": "workspace:^",
    "@greeneek/gnk-session-title": "workspace:^",
    "@greeneek/gnk-skill": "workspace:^",
    "@greeneek/gnk-storage": "workspace:^",
    "@greeneek/gnk-storage-domain": "workspace:^",
    "@greeneek/gnk-storage-json": "workspace:^",
    "@greeneek/gnk-subagent": "workspace:^",
    "@greeneek/gnk-typert-protocol": "workspace:^",
    "@greeneek/gnk-typert-registry": "workspace:^",
    "@greeneek/gnk-util-crypto": "workspace:^",
    "@greeneek/gnk-util-time": "workspace:^",
    "@greeneek/gnk-util-workspace-path": "workspace:^",
    "@greeneek/gnk-workspace": "workspace:^"
  }
}
