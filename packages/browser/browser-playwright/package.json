{
  "name": "@greeneek/gnk-browser-playwright",
  "description": "Real browser content provider for the browser-use seam: navigates pages, extracts bounded visible text and links, follows links, and surfaces navigation failures",
  "version": "0.8.9",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/browser/browser-playwright"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "playwright": "^1.49.0"
  },
  "peerDependencies": {
    "@greeneek/gnk-browser-use": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  },
  "devDependencies": {
    "@greeneek/gnk-browser-use": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  }
}
