{
  "name": "@greeneek/gnk-tool-browser",
  "description": "Model-facing browser tools over ctx.browser: open, navigate, snapshot, and close the visible browser surface",
  "version": "0.8.9",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/browser/tool-browser"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-browser-use": "workspace:^",
    "@greeneek/gnk-tools": "workspace:^",
    "@greeneek/gnk-system-prompt": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  },
  "devDependencies": {
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-browser-use": "workspace:^",
    "@greeneek/gnk-tools": "workspace:^",
    "@greeneek/gnk-system-prompt": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  }
}
