{
  "name": "@greeneek/gnk-sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one Greeneek adapter, persistent shell, editor, and JSONL sessions",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "gnk": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@greeneek/cordis-plugin-timer": "workspace:^",
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-agent-loop": "workspace:^",
    "@greeneek/gnk-greeneek-llm-api-extensions": "workspace:^",
    "@greeneek/gnk-fs-local": "workspace:^",
    "@greeneek/gnk-invariants": "workspace:^",
    "@greeneek/gnk-jobs-local": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-llm-pi-ai": "workspace:^",
    "@greeneek/gnk-llm-retry": "workspace:^",
    "@greeneek/gnk-sandbox-local": "workspace:^",
    "@greeneek/gnk-sandbox-policy": "workspace:^",
    "@greeneek/gnk-scope": "workspace:^",
    "@greeneek/gnk-sdk-app": "workspace:^",
    "@greeneek/gnk-sdk-jsonrpc-server": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-session-persistence-jsonl": "workspace:^",
    "@greeneek/gnk-session-projection": "workspace:^",
    "@greeneek/gnk-session-title": "workspace:^",
    "@greeneek/gnk-subprocess-local": "workspace:^",
    "@greeneek/gnk-system-prompt": "workspace:^",
    "@greeneek/gnk-terminal": "workspace:^",
    "@greeneek/gnk-terminal-bash": "workspace:^",
    "@greeneek/gnk-tool-bash-persistent": "workspace:^",
    "@greeneek/gnk-tool-pwsh-persistent": "workspace:^",
    "@greeneek/gnk-tool-str-replace-editor": "workspace:^",
    "@greeneek/gnk-tools": "workspace:^"
  },
  "peerDependencies": {
    "@greeneek/cordis": "workspace:^"
  },
  "devDependencies": {
    "@greeneek/cordis": "workspace:^"
  }
}
