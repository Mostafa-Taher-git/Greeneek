{
  "name": "@greeneek/gnk-client-connection",
  "description": "Authenticated RPC transport, generation lifecycle, and browser fixture",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/client/connection"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "gnk": {
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "license": "MIT",
  "dependencies": {
    "@greeneek/gnk-credentials": "workspace:^",
    "@greeneek/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ],
  "peerDependencies": {
    "@greeneek/cordis": "workspace:^"
  },
  "devDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-attachment": "workspace:^",
    "@greeneek/gnk-brand": "workspace:^",
    "@greeneek/gnk-commands": "workspace:^",
    "@greeneek/gnk-host-directory-picker": "workspace:^",
    "@greeneek/gnk-host-webserver": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-settings": "workspace:^",
    "@greeneek/gnk-tool-todo": "workspace:^",
    "@greeneek/gnk-util-values": "workspace:^"
  }
}
