{
  "name": "@greeneek/gnk-client-ui-conversation",
  "description": "Target-neutral Conversation assembly, shell, composer, queue, and view navigation",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/client/ui-conversation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "gnk": {
    "client": {
      "inject": [
        "@greeneek/gnk-api-session-controller",
        "@greeneek/gnk-client-locale",
        "@greeneek/gnk-client-ui-layout",
        "@greeneek/gnk-client-ui-renderer",
        "@greeneek/gnk-client-ui-session",
        "@greeneek/gnk-client-ui-settings",
        "@greeneek/gnk-client-ui-workspace"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "clsx": "^2.0.0",
    "@greeneek/schemastery": "workspace:^",
    "@lexical/history": "^0.49.0",
    "@lexical/plain-text": "^0.49.0",
    "@lexical/text": "^0.49.0",
    "@lexical/utils": "^0.49.0",
    "lexical": "^0.49.0"
  },
  "peerDependencies": {
    "@greeneek/cordis": "workspace:^"
  },
  "devDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-api-remotes": "workspace:^",
    "@greeneek/gnk-api-session-controller": "workspace:^",
    "@greeneek/gnk-api-workspace-controller": "workspace:^",
    "@greeneek/gnk-attachment": "workspace:^",
    "@greeneek/gnk-brand": "workspace:^",
    "@greeneek/gnk-client-locale": "workspace:^",
    "@greeneek/gnk-client-store": "workspace:^",
    "@greeneek/gnk-client-test-runtime": "workspace:^",
    "@greeneek/gnk-client-ui-layout": "workspace:^",
    "@greeneek/gnk-client-ui-primitives": "workspace:^",
    "@greeneek/gnk-client-ui-renderer": "workspace:^",
    "@greeneek/gnk-client-ui-session": "workspace:^",
    "@greeneek/gnk-client-ui-settings": "workspace:^",
    "@greeneek/gnk-client-ui-workspace": "workspace:^",
    "@greeneek/gnk-client-ui-slots": "workspace:^",
    "@greeneek/gnk-commands": "workspace:^",
    "@greeneek/gnk-goal": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-llm-retry": "workspace:^",
    "@greeneek/gnk-permission-presets": "workspace:^",
    "@greeneek/gnk-plan-mode": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-token-meter": "workspace:^",
    "@greeneek/gnk-tool-todo": "workspace:^",
    "@greeneek/gnk-util-crypto": "workspace:^",
    "@greeneek/gnk-workspace": "workspace:^",
    "@greeneek/gnk-util-workspace-path": "workspace:^",
    "@types/react": "~18.3.1",
    "react": "^18.2.0",
    "@lexical/headless": "^0.49.0",
    "react-dom": "^18.2.0",
    "@types/react-dom": "~18.3.0",
    "zod": "^4.4.3",
    "@greeneek/gnk-settings": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
