{
  "name": "@greeneek/gnk-client-ui-layout",
  "description": "Shell plugin: three-column AppFrame with drag handles, ctx.layout viewing-state service (navigation + panels)",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/client/ui-layout"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "gnk": {
    "client": {
      "inject": [
        "@greeneek/gnk-client-locale",
        "@greeneek/gnk-client-ui-renderer",
        "@greeneek/gnk-client-ui-session",
        "@greeneek/gnk-client-ui-theme"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@greeneek/cordis": "workspace:^"
  },
  "devDependencies": {
    "@greeneek/gnk-client-locale": "workspace:^",
    "@greeneek/gnk-client-store": "workspace:^",
    "@greeneek/gnk-client-ui-renderer": "workspace:^",
    "@greeneek/gnk-client-ui-session": "workspace:^",
    "@greeneek/gnk-client-ui-slots": "workspace:^",
    "@greeneek/gnk-client-ui-theme": "workspace:^",
    "@types/react": "~18.3.1",
    "@greeneek/cordis": "workspace:^",
    "react": "^18.2.0"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
