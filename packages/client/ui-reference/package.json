{
  "name": "@greeneek/gnk-client-ui-reference",
  "description": "Unified Web @file and @session reference source",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/client/ui-reference"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "gnk": {
    "client": {
      "inject": [
        "@greeneek/gnk-api-remotes",
        "@greeneek/gnk-api-session-controller",
        "@greeneek/gnk-client-connection",
        "@greeneek/gnk-client-locale",
        "@greeneek/gnk-client-ui-input-trigger"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@greeneek/cordis": "workspace:^"
  },
  "devDependencies": {
    "@greeneek/gnk-api-remotes": "workspace:^",
    "@greeneek/gnk-api-session-controller": "workspace:^",
    "@greeneek/gnk-client-connection": "workspace:^",
    "@greeneek/gnk-client-locale": "workspace:^",
    "@greeneek/gnk-client-test-runtime": "workspace:^",
    "@greeneek/gnk-client-ui-input-trigger": "workspace:^",
    "@greeneek/gnk-client-ui-primitives": "workspace:^",
    "@greeneek/gnk-client-ui-slots": "workspace:^",
    "@greeneek/gnk-file-reference": "workspace:^",
    "@greeneek/gnk-session-reference": "workspace:^",
    "@greeneek/gnk-typert-protocol": "workspace:^",
    "@greeneek/gnk-util-workspace-path": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
