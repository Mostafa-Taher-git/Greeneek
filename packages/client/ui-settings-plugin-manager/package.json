{
  "name": "@greeneek/gnk-client-ui-settings-plugin-manager",
  "description": "Plugins settings section: built-in plugin settings, experimental plugins, refresh, add-plugin dialog and registry selection",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./client": { "types": "./lib/types/client/index.d.ts", "default": "./lib/client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "gnk": {
    "client": {
      "inject": [
        "@greeneek/gnk-api-remotes",
        "@greeneek/gnk-client-ui-settings",
        "@greeneek/gnk-client-locale",
        "@greeneek/gnk-client-ui-slots",
        "@greeneek/gnk-client-ui-layout"
      ],
      "platform": "web"
    }
  },
  "scripts": { "bundle": "tsdown" },
  "license": "MIT",
  "peerDependencies": { "@greeneek/cordis": "workspace:^" },
  "devDependencies": {
    "@greeneek/gnk-api-remotes": "workspace:^",
    "@greeneek/gnk-client-locale": "workspace:^",
    "@greeneek/gnk-client-ui-primitives": "workspace:^",
    "@greeneek/gnk-client-ui-renderer": "workspace:^",
    "@greeneek/gnk-client-ui-layout": "workspace:^",
    "@greeneek/gnk-client-ui-settings": "workspace:^",
    "@greeneek/gnk-client-ui-slots": "workspace:^",
    "@greeneek/cordis": "workspace:^",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@types/react": "~18.3.1"
  },
  "files": ["lib/index.js", "lib/client.js", "lib/types/**/*.d.ts"]
}
