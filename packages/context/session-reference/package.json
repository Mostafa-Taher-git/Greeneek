{
  "name": "@greeneek/gnk-session-reference",
  "description": "Cross-session snapshot references and durable untrusted model context (ctx.sessionReferenceResolver)",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/context/session-reference"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@greeneek/gnk-brand": "workspace:^",
    "@greeneek/gnk-util-values": "workspace:^",
    "@greeneek/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-compaction": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-output-retention": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-session-projection": "workspace:^",
    "@greeneek/gnk-session-projection-cache": "workspace:^",
    "@greeneek/gnk-session-query": "workspace:^",
    "@greeneek/gnk-session-title": "workspace:^",
    "@greeneek/gnk-typert-protocol": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@greeneek/gnk-session-projection-cache": {
      "optional": true
    }
  },
  "devDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-compaction": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-output-retention": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-session-projection": "workspace:^",
    "@greeneek/gnk-session-projection-cache": "workspace:^",
    "@greeneek/gnk-session-query": "workspace:^",
    "@greeneek/gnk-session-title": "workspace:^",
    "@greeneek/gnk-typert-protocol": "workspace:^"
  }
}
