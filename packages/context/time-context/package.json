{
  "name": "@greeneek/gnk-time-context",
  "description": "Opt-in durable per-step context with the current time and elapsed time",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/context/time-context"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@greeneek/gnk-util-values": "workspace:^",
    "@greeneek/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-invariants": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-session-projection": "workspace:^"
  },
  "devDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-agent-loop": "workspace:^",
    "@greeneek/gnk-agent-loop-testkit": "workspace:^",
    "@greeneek/gnk-app-boot": "workspace:^",
    "@greeneek/gnk-bash-local": "workspace:^",
    "@greeneek/gnk-invariants": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-loader-smoke": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-session-checkpoint-policy": "workspace:^",
    "@greeneek/gnk-session-persistence-jsonl": "workspace:^",
    "@greeneek/gnk-session-projection": "workspace:^",
    "@greeneek/gnk-subprocess-local": "workspace:^",
    "@greeneek/gnk-system-prompt": "workspace:^",
    "@greeneek/gnk-tools": "workspace:^"
  }
}
