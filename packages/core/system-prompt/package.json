{
  "name": "@greeneek/gnk-system-prompt",
  "description": "System prompt assembly registry for the Greeneek Harness",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/core/system-prompt"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@greeneek/gnk-invariants": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-scope": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  },
  "dependencies": {
    "@greeneek/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@greeneek/gnk-invariants": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-scope": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  }
}
