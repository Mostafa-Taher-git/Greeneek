{
  "name": "@greeneek/gnk-craft-local",
  "description": "Local host provider for the Greeneek Harness Craft bridge: launcher and registry discovery, absolute CLI resolution, and token-gated headless sessions through ctx.subprocess",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/craft/craft-local"
  },
  "type": "module",
  "scripts": {
    "smoke:discovery": "node --import tsx/esm scripts/check-discovery.ts",
    "smoke:serve": "node --import tsx/esm scripts/check-serve.mjs"
  },
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-craft": "workspace:^",
    "@greeneek/gnk-subprocess": "workspace:^"
  },
  "dependencies": {
    "@greeneek/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-craft": "workspace:^",
    "@greeneek/gnk-subprocess": "workspace:^",
    "@greeneek/gnk-subprocess-local": "workspace:^"
  }
}
