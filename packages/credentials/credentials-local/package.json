{
  "name": "@greeneek/gnk-credentials-local",
  "description": "File-backed credentials provider ($GNK_HOME/.env under the live process environment) for the Greeneek Harness",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/credentials/credentials-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@greeneek/gnk-atomic-write": "workspace:^",
    "@greeneek/gnk-credentials": "workspace:^",
    "@greeneek/gnk-launch-environment": "workspace:^",
    "@greeneek/gnk-home-paths": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "@greeneek/schemastery": "workspace:^",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@greeneek/gnk-atomic-write": "workspace:^",
    "@greeneek/gnk-credentials": "workspace:^",
    "@greeneek/gnk-launch-environment": "workspace:^",
    "@greeneek/gnk-home-paths": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  }
}
