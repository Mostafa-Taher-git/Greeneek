{
  "name": "@greeneek/gnk-deep-agent-runtime",
  "description": "Deep-agent Host runtime: owns the domain store, engine, effects, policy and management Remotes",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": { "types": "./lib/types/index.d.ts", "default": "./lib/index.js" },
    "./types": { "types": "./lib/types/types-public.d.ts", "default": "./lib/types/types-public.js" },
    "./typert": { "types": "./lib/typert.host.d.ts", "default": "./lib/typert.host.js" },
    "./remote": { "types": "./lib/typert.remote-client.d.ts", "default": "./lib/typert.remote-client.js" },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "scripts": { "bundle": "tsdown" },
  "license": "MIT",
  "peerDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-typert-protocol": "workspace:^",
    "@greeneek/gnk-home-paths": "workspace:^",
    "@greeneek/gnk-deep-agent-core": "workspace:^",
    "@greeneek/gnk-deep-agent-store": "workspace:^",
    "@greeneek/gnk-deep-agent-effects": "workspace:^",
    "@greeneek/gnk-deep-agent-policy": "workspace:^",
    "@greeneek/gnk-deep-agent-executor": "workspace:^",
    "@greeneek/gnk-deep-agent-sources": "workspace:^",
    "@greeneek/gnk-credentials": "workspace:^"
  },
  "devDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-typert-protocol": "workspace:^",
    "@greeneek/gnk-home-paths": "workspace:^",
    "@greeneek/gnk-deep-agent-core": "workspace:^",
    "@greeneek/gnk-deep-agent-store": "workspace:^",
    "@greeneek/gnk-deep-agent-effects": "workspace:^",
    "@greeneek/gnk-deep-agent-policy": "workspace:^",
    "@greeneek/gnk-deep-agent-executor": "workspace:^",
    "@greeneek/gnk-deep-agent-sources": "workspace:^",
    "@greeneek/gnk-credentials": "workspace:^",
    "typescript": "^5.7.2",
    "vitest": "^4.1.8"
  },
  "dependencies": { "zod": "^4.4.3" },
  "files": [
    "lib/index.js", "lib/types/**/*.js", "lib/types/**/*.d.ts",
    "lib/typert.host.js", "lib/typert.host.d.ts", "lib/typert.remote-client.js", "lib/typert.remote-client.d.ts"
  ]
}
