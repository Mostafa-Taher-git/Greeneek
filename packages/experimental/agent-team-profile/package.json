{
  "name": "@greeneek/gnk-experimental-agent-team-profile",
  "description": "Private profile bundle enabling Agent Teams over gnk-base",
  "version": "1.1.0-alpha.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/experimental/agent-team-profile"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "gnk": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@greeneek/gnk-experimental-agent-team": "workspace:^",
    "@greeneek/gnk-experimental-tool-agent-team": "workspace:^"
  },
  "peerDependencies": {
    "@greeneek/cordis": "workspace:^"
  },
  "devDependencies": {
    "@greeneek/cordis-plugin-include": "workspace:^",
    "@greeneek/cordis": "workspace:^",
    "js-yaml": "^4.2.0"
  }
}
