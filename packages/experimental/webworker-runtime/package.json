{
  "name": "@greeneek/gnk-experimental-webworker-runtime",
  "description": "Browser-only harness runtime: in-memory VFS, module transform and loader, postMessage tunnel, and the dedicated Web Worker assembly, with the Node-compatibility layer that lets the host tree run unchanged",
  "version": "1.1.0-alpha.0",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/experimental/webworker-runtime"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./worker": "./lib/worker.js",
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    }
  },
  "license": "MIT",
  "dependencies": {
    "@greeneek/gnk-util-crypto": "workspace:^",
    "@noble/hashes": "^2.3.0",
    "@yarnpkg/parsers": "^3.1.0",
    "acorn": "^8.17.0",
    "buffer": "^6.0.3",
    "picomatch": "^4.0.4",
    "readable-stream": "^4.7.0"
  },
  "peerDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/cordis-plugin-loader": "workspace:^",
    "@greeneek/gnk-client-connection": "workspace:^",
    "@greeneek/gnk-client-modules": "workspace:^",
    "@greeneek/gnk-host-webserver": "workspace:^"
  },
  "devDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/cordis-plugin-loader": "workspace:^",
    "@greeneek/gnk-api-gateway": "workspace:^",
    "@greeneek/gnk-bash-sandbox": "workspace:^",
    "@greeneek/gnk-client-connection": "workspace:^",
    "@greeneek/gnk-client-modules": "workspace:^",
    "@greeneek/gnk-host-webserver": "workspace:^",
    "@greeneek/gnk-sandbox-local": "workspace:^",
    "@greeneek/gnk-sandbox-policy": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-session-projection": "workspace:^",
    "@greeneek/gnk-session-persistence-jsonl": "workspace:^",
    "@greeneek/gnk-subagent": "workspace:^",
    "@greeneek/gnk-subprocess-local": "workspace:^",
    "@greeneek/node-addon-landlock-run": "workspace:^",
    "@types/picomatch": "^3.0.2",
    "@types/readable-stream": "^4.0.24",
    "chokidar": "^5.0.0"
  },
  "files": [
    "lib/index.js",
    "lib/worker.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
