{
  "name": "@greeneek/gnk-message-feedback",
  "description": "Lifecycle-bound per-message rating and note sidecar for the Greeneek Harness",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/feedback/message-feedback"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@greeneek/gnk-brand": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-session-persistence": "workspace:^",
    "@greeneek/gnk-storage-domain": "workspace:^",
    "@greeneek/gnk-typert-protocol": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  },
  "dependencies": {
    "@greeneek/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@greeneek/cordis-plugin-include": "workspace:^",
    "@greeneek/cordis-plugin-loader": "workspace:^",
    "@greeneek/gnk-brand": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-session-persistence": "workspace:^",
    "@greeneek/gnk-session-persistence-jsonl": "workspace:^",
    "@greeneek/gnk-storage": "workspace:^",
    "@greeneek/gnk-storage-domain": "workspace:^",
    "@greeneek/gnk-storage-json": "workspace:^",
    "@greeneek/gnk-typert-protocol": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  }
}
