{
  "name": "@greeneek/gnk-fs-local",
  "description": "Local-filesystem implementation of the Greeneek Harness filesystem seam (ctx.fs)",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/fs/fs-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@greeneek/gnk-fs": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  },
  "dependencies": {
    "koffi": "^3.1.0",
    "@greeneek/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@greeneek/gnk-fs": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  }
}
