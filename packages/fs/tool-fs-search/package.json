{
  "name": "@greeneek/gnk-tool-fs-search",
  "description": "Model-facing filesystem discovery tools (glob, grep) backed by the packaged ripgrep binary (@vscode/ripgrep)",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/fs/tool-fs-search"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@vscode/ripgrep": "^1.18.0",
    "@greeneek/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-output-retention": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-spill": "workspace:^",
    "@greeneek/gnk-subprocess": "workspace:^",
    "@greeneek/gnk-system-prompt": "workspace:^",
    "@greeneek/gnk-timeout": "workspace:^",
    "@greeneek/gnk-tools": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  },
  "devDependencies": {
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-subprocess": "workspace:^",
    "@greeneek/gnk-subprocess-local": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-output-retention": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-spill": "workspace:^",
    "@greeneek/gnk-system-prompt": "workspace:^",
    "@greeneek/gnk-timeout": "workspace:^",
    "@greeneek/gnk-tools": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  }
}
