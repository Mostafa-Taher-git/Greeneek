{
  "name": "@greeneek/gnk-goal",
  "description": "Event-sourced same-session goal state and lifecycle service for the Greeneek Harness",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/goal/goal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-session-projection": "workspace:^",
    "@greeneek/gnk-brand": "workspace:^",
    "@greeneek/gnk-invariants": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-scope": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-typert-protocol": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  },
  "dependencies": {
    "@greeneek/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-bash-local": "workspace:^",
    "@greeneek/gnk-session-projection": "workspace:^",
    "@greeneek/gnk-brand": "workspace:^",
    "@greeneek/gnk-invariants": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-loader-smoke": "workspace:^",
    "@greeneek/gnk-scope": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-session-checkpoint-policy": "workspace:^",
    "@greeneek/gnk-session-persistence-jsonl": "workspace:^",
    "@greeneek/gnk-subprocess-local": "workspace:^",
    "@greeneek/gnk-typert-protocol": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  }
}
