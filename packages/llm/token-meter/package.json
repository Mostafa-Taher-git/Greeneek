{
  "name": "@greeneek/gnk-token-meter",
  "description": "Replay-aware token measurement service (ctx.tokenMeter) for the Greeneek Harness",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/llm/token-meter"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-compaction": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-llm-retry": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-session-projection": "workspace:^"
  },
  "dependencies": {
    "@greeneek/gnk-util-values": "workspace:^",
    "@greeneek/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-compaction": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-llm-retry": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-session-projection": "workspace:^"
  }
}
