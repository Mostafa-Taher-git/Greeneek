{
  "name": "@greeneek/gnk-tool-lsp",
  "description": "Model-facing lsp tool over the Greeneek Harness LSP capability seam (ctx.lsp) — one read-only tool with goToDefinition/findReferences/goToImplementation/hover operations, one-based UTF-16 cursor coordinates, bounded location rendering, and hover normalization",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/lsp/tool-lsp"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-lsp": "workspace:^",
    "@greeneek/gnk-system-prompt": "workspace:^",
    "@greeneek/gnk-timeout": "workspace:^",
    "@greeneek/gnk-tools": "workspace:^"
  },
  "dependencies": {
    "@greeneek/gnk-util-values": "workspace:^",
    "@greeneek/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-fs-local": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-lsp": "workspace:^",
    "@greeneek/gnk-lsp-stdio": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-subprocess-local": "workspace:^",
    "@greeneek/gnk-system-prompt": "workspace:^",
    "@greeneek/gnk-timeout": "workspace:^",
    "@greeneek/gnk-tool-call-timeout-policy": "workspace:^",
    "@greeneek/gnk-tools": "workspace:^"
  }
