    "@greeneek/gnk-timeout": "workspace:^",
    "@greeneek/gnk-tools": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "@greeneek/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@greeneek/gnk-attachment": "workspace:^",
    "@greeneek/gnk-attachment-local": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-scope": "workspace:^",
    "@greeneek/gnk-subprocess": "workspace:^",
    "@greeneek/gnk-timeout": "workspace:^",
    "@greeneek/gnk-tools": "workspace:^",
    "@modelcontextprotocol/server-everything": "^2026.7.4",
    "@modelcontextprotocol/server-filesystem": "^2026.7.4",
    "@greeneek/cordis": "workspace:^"
  }
}
