{
  "name": "@greeneek/gnk-agent-presets",
  "description": "Per-session agent composition from preset cordis.yml files for the Greeneek Harness",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/preset/agent-presets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./display": {
      "types": "./lib/types/display.d.ts",
      "default": "./lib/types/display.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "presets",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@greeneek/cordis-plugin-include": "workspace:^",
    "@greeneek/cordis-plugin-loader": "workspace:^",
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-atomic-write": "workspace:^",
    "@greeneek/gnk-invariants": "workspace:^",
    "@greeneek/gnk-home-paths": "workspace:^",
    "@greeneek/gnk-scope": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-session-projection": "workspace:^",
    "@greeneek/gnk-settings": "workspace:^",
    "@greeneek/gnk-system-prompt": "workspace:^",
    "@greeneek/gnk-tools": "workspace:^",
    "@greeneek/gnk-typert-protocol": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  },
  "dependencies": {
    "js-yaml": "^4.1.0",
    "@greeneek/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@greeneek/cordis-plugin-group": "workspace:^",
    "@greeneek/cordis-plugin-include": "workspace:^",
    "@greeneek/cordis-plugin-loader": "workspace:^",
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-agent-loop": "workspace:^",
    "@greeneek/gnk-atomic-write": "workspace:^",
    "@greeneek/gnk-invariants": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-home-paths": "workspace:^",
    "@greeneek/gnk-scope": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-session-projection": "workspace:^",
    "@greeneek/gnk-settings": "workspace:^",
    "@greeneek/gnk-settings-file": "workspace:^",
    "@greeneek/gnk-system-prompt": "workspace:^",
    "@greeneek/gnk-tools": "workspace:^",
    "@greeneek/gnk-typert-protocol": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  }
}
