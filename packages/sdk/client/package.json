{
  "name": "@greeneek/gnk-sdk-client",
  "description": "TypeScript client SDK for driving a Greeneek Harness runtime subprocess over stdio JSON-RPC: the GreeneekHarness high-level turns API and the lower-level HarnessClient",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/sdk/client"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@greeneek/gnk": "workspace:*"
  },
  "peerDependencies": {
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-sdk-protocol": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  },
  "devDependencies": {
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-sdk-protocol": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  }
}
