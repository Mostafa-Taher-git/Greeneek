{
  "name": "@greeneek/gnk-sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process Greeneek Harness SDK clients",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@greeneek/gnk-brand": "workspace:^",
    "@greeneek/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-attachment": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-llm-greeneek": "workspace:^",
    "@greeneek/gnk-scope": "workspace:^",
    "@greeneek/gnk-sdk-protocol": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-subagent": "workspace:^"
  },
  "devDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/cordis-plugin-loader": "workspace:^",
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-agent-loop": "workspace:^",
    "@greeneek/gnk-agent-loop-testkit": "workspace:^",
    "@greeneek/gnk-attachment": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-llm-greeneek": "workspace:^",
    "@greeneek/gnk-scope": "workspace:^",
    "@greeneek/gnk-sdk-protocol": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-session-persistence-jsonl": "workspace:^",
    "@greeneek/gnk-session-projection": "workspace:^",
    "@greeneek/gnk-subagent": "workspace:^"
  }
}
