{
  "name": "@greeneek/gnk-session-telemetry-otel",
  "description": "OpenTelemetry backend for the Greeneek Harness telemetry seam: hands captured session records to the OTel JS SDK's log pipeline",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/session/session-telemetry-otel"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/api-logs": "^0.220.0",
    "@opentelemetry/exporter-logs-otlp-http": "^0.220.0",
    "@opentelemetry/otlp-exporter-base": "^0.220.0",
    "@opentelemetry/resources": "^2.9.0",
    "@opentelemetry/sdk-logs": "^0.220.0",
    "@greeneek/schemastery": "workspace:^"
  },
  "peerDependencies": {
    "@greeneek/gnk-command-feedback": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-session-telemetry": "workspace:^",
    "@greeneek/gnk-anonymous-user-id": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  },
  "devDependencies": {
    "@greeneek/cordis-plugin-logger-console": "workspace:^",
    "@greeneek/cordis-plugin-loader": "workspace:^",
    "@greeneek/gnk-app-boot": "workspace:^",
    "@greeneek/gnk-bash-local": "workspace:^",
    "@greeneek/gnk-command-feedback": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-loader-smoke": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-session-checkpoint-policy": "workspace:^",
    "@greeneek/gnk-session-persistence-jsonl": "workspace:^",
    "@greeneek/gnk-session-telemetry": "workspace:^",
    "@greeneek/gnk-subprocess-local": "workspace:^",
    "@greeneek/gnk-anonymous-user-id": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  }
}
