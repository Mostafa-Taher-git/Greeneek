{
  "name": "@greeneek/gnk-bash-sandbox",
  "description": "Sandbox-consuming implementation of the Greeneek Harness bash executor seam (confines every command via ctx.sandbox, reports denial/enforcement result facts)",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/shell/bash-sandbox"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@greeneek/gnk-shell": "workspace:^",
    "@greeneek/gnk-bash-local": "workspace:^",
    "@greeneek/gnk-sandbox": "workspace:^",
    "@greeneek/gnk-sandbox-policy": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  },
  "devDependencies": {
    "@greeneek/gnk-shell": "workspace:^",
    "@greeneek/gnk-bash-local": "workspace:^",
    "@greeneek/gnk-subprocess-local": "workspace:^",
    "@greeneek/gnk-sandbox": "workspace:^",
    "@greeneek/gnk-sandbox-local": "workspace:^",
    "@greeneek/gnk-sandbox-policy": "workspace:^",
    "@greeneek/cordis": "workspace:^",
    "@greeneek/node-addon-landlock-run": "workspace:^",
    "@greeneek/gnk-session-projection": "workspace:^"
  }
}
