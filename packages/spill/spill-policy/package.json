{
  "name": "@greeneek/gnk-spill-policy",
  "description": "Tool-result spill policy for the Greeneek Harness — replaces oversized plain-text tool results with a retained preview plus a spill-file path (no service API)",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/spill/spill-policy"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-output-retention": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-spill": "workspace:^",
    "@greeneek/gnk-tools": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  },
  "dependencies": {
    "@greeneek/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-code-runtime-worker-thread": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-output-retention": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-spill": "workspace:^",
    "@greeneek/gnk-tools": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  }
}
