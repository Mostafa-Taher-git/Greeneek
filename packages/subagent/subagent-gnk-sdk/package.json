{
  "name": "@greeneek/gnk-subagent-gnk-sdk",
  "description": "Out-of-process SDK subagent backend: drives a child Greeneek Harness runtime subprocess over stdio JSON-RPC through the TypeScript SDK client",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/subagent/subagent-gnk-sdk"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-sdk-client": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-subagent": "workspace:^",
    "@greeneek/gnk-subprocess": "workspace:^"
  },
  "dependencies": {
    "@greeneek/gnk-brand": "workspace:^",
    "@greeneek/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/cordis-plugin-loader": "workspace:^",
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-agent-instructions": "workspace:^",
    "@greeneek/gnk-app-boot": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-llm-greeneek": "workspace:^",
    "@greeneek/gnk-loader-smoke": "workspace:^",
    "@greeneek/gnk-sdk-client": "workspace:^",
    "@greeneek/gnk-sdk-protocol": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-session-checkpoint-policy": "workspace:^",
    "@greeneek/gnk-session-persistence-jsonl": "workspace:^",
    "@greeneek/gnk-session-projection": "workspace:^",
    "@greeneek/gnk-skill-filesystem": "workspace:^",
    "@greeneek/gnk-subagent": "workspace:^",
    "@greeneek/gnk-subprocess": "workspace:^",
    "@greeneek/gnk-system-prompt": "workspace:^",
    "@greeneek/gnk-tool-subagent": "workspace:^"
  }
}
