{
  "name": "@greeneek/gnk-subprocess-local",
  "description": "Local-subprocess implementation of the Greeneek Harness subprocess seam",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/subprocess/subprocess-local"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "scripts/ensure-spawn-helper.mjs",
    "lib/types/**/*.d.ts"
  ],
  "scripts": {
    "postinstall": "node scripts/ensure-spawn-helper.mjs"
  },
  "license": "MIT",
  "peerDependencies": {
    "@greeneek/gnk-subprocess": "workspace:^",
    "@greeneek/gnk-timeout": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  },
  "dependencies": {
    "koffi": "^3.1.0",
    "node-pty": "1.2.0-beta.15"
  },
  "devDependencies": {
    "@greeneek/gnk-loader-smoke": "workspace:^",
    "@greeneek/gnk-subprocess": "workspace:^",
    "@greeneek/gnk-timeout": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  }
}
