{
  "name": "@greeneek/gnk-terminal-bash",
  "description": "Persistent shell PTY backend over the Greeneek Harness subprocess terminal primitive",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/terminal/terminal-bash"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-terminal": "workspace:^",
    "@greeneek/gnk-sandbox": "workspace:^",
    "@greeneek/gnk-sandbox-policy": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-subprocess": "workspace:^",
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-session-projection": "workspace:^"
  },
  "dependencies": {
    "@greeneek/gnk-pwsh-local": "workspace:^",
    "@greeneek/schemastery": "workspace:^",
    "@xterm/headless": "^6.0.0"
  },
  "devDependencies": {
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-terminal": "workspace:^",
    "@greeneek/gnk-sandbox": "workspace:^",
    "@greeneek/gnk-sandbox-policy": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-subprocess": "workspace:^",
    "@greeneek/gnk-subprocess-local": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  }
}
