{
  "name": "@greeneek/gnk-tool-todo",
  "description": "Model-facing todo_write tool over the Greeneek Harness event-sourced session log",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/todo/tool-todo"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./invariant": {
      "types": "./lib/types/invariant.d.ts",
      "default": "./lib/invariant.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/invariant.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@greeneek/schemastery": "workspace:^",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-invariants": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-session-projection": "workspace:^",
    "@greeneek/gnk-tools": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  },
  "devDependencies": {
    "@greeneek/cordis-plugin-include": "workspace:^",
    "@greeneek/cordis-plugin-loader": "workspace:^",
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-agent-loop": "workspace:^",
    "@greeneek/gnk-agent-loop-testkit": "workspace:^",
    "@greeneek/gnk-invariants": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-session-projection": "workspace:^",
    "@greeneek/gnk-system-prompt": "workspace:^",
    "@greeneek/gnk-tools": "workspace:^",
    "@greeneek/gnk-user-questions": "workspace:^",
    "@greeneek/cordis": "workspace:^"
  }
}
