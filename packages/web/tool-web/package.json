    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-llm": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-spill-local": "workspace:^",
    "@greeneek/gnk-spill-policy": "workspace:^",
    "@greeneek/gnk-system-prompt": "workspace:^",
    "@greeneek/gnk-tool-call-timeout-policy": "workspace:^",
    "@greeneek/gnk-tools": "workspace:^",
    "@greeneek/gnk-web": "workspace:^",
    "@greeneek/gnk-web-fetch-http": "workspace:^",
    "@greeneek/gnk-web-search-exa": "workspace:^",
