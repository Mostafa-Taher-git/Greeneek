    "@greeneek/gnk-egress": "workspace:^",
    "@greeneek/gnk-launch-environment": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-web": "workspace:^",
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-settings": "workspace:^"
  },
  "dependencies": {
    "@greeneek/schemastery": "workspace:^"
  },
  "devDependencies": {
    "@greeneek/gnk-agent": "workspace:^",
    "@greeneek/gnk-credentials": "workspace:^",
    "@greeneek/gnk-credentials-local": "workspace:^",
    "@greeneek/gnk-egress": "workspace:^",
    "@greeneek/gnk-launch-environment": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-web": "workspace:^",
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-settings": "workspace:^"
  }
}
