{
  "name": "@greeneek/gnk-webhook-github",
  "description": "Signed GitHub HTTP webhook adapter for the Greeneek Harness webhook runtime",
  "version": "1.1.0-alpha.0",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/greeneek/greeneek-harness.git",
    "directory": "packages/webhook/webhook-github"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/gnk-credentials": "workspace:^",
    "@greeneek/gnk-host-webserver": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-webhook": "workspace:^"
  },
  "dependencies": {
    "@greeneek/gnk-util-values": "workspace:^",
    "@greeneek/schemastery": "workspace:^",
    "@octokit/webhooks": "^14.2.0"
  },
  "devDependencies": {
    "@greeneek/cordis": "workspace:^",
    "@greeneek/cordis-plugin-include": "workspace:^",
    "@greeneek/cordis-plugin-loader": "workspace:^",
    "@greeneek/gnk-credentials": "workspace:^",
    "@greeneek/gnk-host-webserver": "workspace:^",
    "@greeneek/gnk-session": "workspace:^",
    "@greeneek/gnk-webhook": "workspace:^"
  }
}
