{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "ignorePaths": [
    "vendor/**",
    "patchedDependencies/**"
  ],
  "schedule": ["every monday"],
  "packageRules": [
    {
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "non-major dependencies",
      "groupSlug": "non-major"
    },
    {
      "matchManagers": ["npm"],
      "matchPaths": ["vendor/**"],
      "enabled": false
    }
  ]
}
